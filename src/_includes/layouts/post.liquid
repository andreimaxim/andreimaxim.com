---
layout: default.liquid
---
{%- assign related = collections.research | related: topics -%}
<article class="entry g">
    <aside class="mg">
        <b>Essay</b>
        <time datetime="{{ date | dateIso }}">{{ date | dateReadable }}</time>
        {% if topics %}<span>{{ topics | join: ", " }}</span>{% endif %}
        <span>{{ content | words }}</span>
    </aside>
    <div class="tx">
        <h1>{{ title }}</h1>
        {% if description %}<p class="standfirst">{{ description }}</p>{% endif %}
        <div class="content">
            {{ content }}
        </div>
    </div>
    {%- if related.size > 0 %}
    <aside class="mg"><b>See also</b><span>research on the same topics</span></aside>
    <div class="tx rows">
        {%- for note in related %}
        <div class="row"><a href="{{ note.url }}">{{ note.data.title }}</a><time datetime="{{ note.date | dateIso }}">{{ note.date | dateShort }}</time></div>
        {%- endfor %}
    </div>
    {%- endif %}
</article>
