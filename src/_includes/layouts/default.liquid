<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>

    {%- assign meta_description = description | default: site.description %}
    <meta name="description" content="{{ meta_description | escape }}"/>

    <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}"/>
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}: writing"/>
    <link rel="alternate" type="application/atom+xml" href="/research.xml" title="{{ site.title }}: research"/>
    <link rel="apple-touch-icon" sizes="300x300" href="/assets/img/andreimaxim.jpg"/>
    <link rel="icon" type="image/png" sizes="300x300" href="/assets/img/andreimaxim.jpg"/>

    {%- if tags contains "posts" %}
        {%- assign og_image = page.url | append: "cover.png" %}
        {%- assign og_type = "article" %}
        {%- assign twitter_card = "summary_large_image" %}
    {%- elsif tags contains "books" %}
        {%- assign og_image = page.url | append: "cover.jpg" %}
        {%- assign og_type = "article" %}
        {%- assign twitter_card = "summary" %}
    {%- elsif tags contains "research" %}
        {%- assign og_image = "/assets/img/andreimaxim.jpg" %}
        {%- assign og_type = "article" %}
        {%- assign twitter_card = "summary" %}
    {%- else %}
        {%- assign og_image = "/assets/img/andreimaxim.jpg" %}
        {%- assign og_type = "website" %}
        {%- assign twitter_card = "summary" %}
    {%- endif %}

    <meta property="og:title" content="{% if title %}{{ title | escape }} | {% endif %}{{ site.title }}"/>
    <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}"/>
    <meta property="og:image" content="{{ site.baseUrl }}{{ og_image }}"/>
    <meta property="og:type" content="{{ og_type }}"/>
    <meta property="og:description" content="{{ meta_description | escape }}"/>

    <meta name="twitter:card" content="{{ twitter_card }}"/>
    <meta name="twitter:site" content="@rockatanescu"/>
    <meta name="twitter:title" content="{% if title %}{{ title | escape }} | {% endif %}{{ site.title }}"/>
    <meta name="twitter:image" content="{{ site.baseUrl }}{{ og_image }}"/>
    <meta name="twitter:description" content="{{ meta_description | escape }}"/>

    <meta name="color-scheme" content="light dark"/>

    <link rel="me" href="https://twitter.com/rockatanescu"/>
    <link rel="me" href="https://github.com/andreimaxim"/>
    <link rel="me" href="https://www.linkedin.com/in/andreimaxim/"/>

    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap"/>
    <link rel="stylesheet" href="/assets/css/prism.css"/>
    <link rel="stylesheet" href="/assets/css/main.css"/>
</head>
<body>
    <div class="page">
        {% include "partials/masthead.liquid" %}
        <main>
            {{ content }}
        </main>
        {% include "partials/footer.liquid" %}
    </div>
</body>
</html>
