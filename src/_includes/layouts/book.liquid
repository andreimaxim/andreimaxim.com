---
layout: default.liquid
---
<article class="entry g">
    <aside class="mg">
        <img src="{{ page.url }}cover.jpg" alt="Cover of {{ title }}" width="600" height="900"/>
        <span class="pill">{{ status | default: "queued" }}</span>
        {% if rating %}<span class="stars" aria-label="Rated {{ rating }} out of 5">{{ rating | stars }}</span>{% endif %}
        <span>{{ author }}</span>
        {% if year %}<span>{{ year }}</span>{% endif %}
        {% if finished %}<span>read {{ finished | dateMonth }}</span>{% elsif started %}<span>since {{ started | dateReadable }}</span>{% endif %}
        {% if isbn %}<span>ISBN {{ isbn }}</span>{% endif %}
    </aside>
    <div class="tx">
        <h1>{{ title }}</h1>
        {% if description %}<p class="standfirst">{{ description }}</p>{% endif %}
        {% if verdict %}<blockquote class="verdict">{{ verdict }}</blockquote>{% endif %}
        <div class="content">
            {{ content }}
        </div>
    </div>
</article>
