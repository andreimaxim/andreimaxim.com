---
layout: default.liquid
title: Writing
description: Every essay on the site, by year.
permalink: /archive/
---
<section class="g">
    <aside class="mg">
        <b>Writing</b>
        <span>{{ collections.posts.size }} essays</span>
    </aside>
    <div class="tx">
        <h1>Writing</h1>
        <p class="standfirst">Essays on Ruby, Rails and the occasional detour, by year.</p>
    </div>
</section>
{%- for year in collections.postsByYear %}
<section class="g">
    <aside class="mg"><b>{{ year.name }}</b></aside>
    <div class="tx rows">
        {%- for post in year.items %}
        <div class="row"><a href="{{ post.url }}">{{ post.data.title }}</a><time datetime="{{ post.date | dateIso }}">{{ post.date | dateShort }}</time></div>
        {%- endfor %}
    </div>
</section>
{%- endfor %}
